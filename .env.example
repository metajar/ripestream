CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-with-a-strong-password
CLICKHOUSE_DB=ripestream
CLICKHOUSE_MEMORY_LIMIT=8g
FALKORDB_GRAPH=ripestream
RIPESTREAM_LOG_LEVEL=info

# Private Cloudflare R2 bucket containing GeoLite2-ASN.mmdb.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-private-bucket
R2_OBJECT_KEY=GeoLite2-ASN.mmdb
R2_JURISDICTION=default

# Optional integrity check for the downloaded MMDB.
GEOLITE_DB_SHA256=
