# Feature flags (build-time). Set to "true" to enable, leave unset/false to
# disable. These are read by Vite via import.meta.env and baked in at build
# time — toggling requires a rebuild (dev server picks up changes on restart).
#
# Copy this file to web/.env and edit as needed.

# Alerting UI: rule builder, active-alerts list, alert events.
VITE_FEATURE_ALERTS=false
